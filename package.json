{
  "name": "portfoy-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Mobil öncelikli FSBO takip uygulaması",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:governance": "vitest run tests/governance",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "security:static": "node scripts/verify-release-boundary.mjs",
    "security:verify": "pnpm security:static && pnpm audit:prod && pnpm test:security && pnpm test:governance",
    "release:verify": "pnpm security:static && pnpm audit:prod && pnpm check && pnpm db:verify",
    "release:assert-live-pii": "node scripts/assert-live-pii-release.mjs",
    "secrets:inspect-keyrings": "node scripts/inspect-secret-keyrings.mjs",
    "supabase:start": "supabase start -x edge-runtime,imgproxy,logflare,mailpit,postgres-meta,realtime,studio,supavisor,vector",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:env": "node scripts/sync-local-supabase-env.mjs",
    "pii:local-keys": "node scripts/create-local-pii-keys.mjs",
    "supabase:verify": "node scripts/verify-local-supabase.mjs",
    "auth:local-user": "node scripts/create-local-auth-user.mjs",
    "auth:verify": "node scripts/verify-local-auth-workspace.mjs",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level error",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:verify": "pnpm db:reset && pnpm db:lint && pnpm db:test && pnpm supabase:verify && pnpm auth:verify && pnpm db:types",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "libphonenumber-js": "^1.13.9",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
