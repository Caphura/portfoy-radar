# Bu dosyada yalnızca değişken adları ve güvenli varsayılanlar bulunur.
# Gizli anahtarları .env.local içinde veya üretim secret manager'ında tutun.
APP_LOCALE=tr-TR
APP_TIME_ZONE=Europe/Istanbul
APP_CURRENCY=TRY

# Yerel değerleri `pnpm supabase:start` sonrasında `pnpm supabase:env` doldurur.
# Üretim değerlerini yalnızca barındırma sağlayıcısının secret manager'ında tutun.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Yalnız server-only Storage/DAL modülleri ve şifreli yedek işi kullanır.
SUPABASE_SERVICE_ROLE_KEY=

# Yalnızca sunucuda kullanılır. Yerel değerleri `pnpm pii:local-keys` üretir.
# Üretimde keyring değerlerini secret manager/KMS üzerinden sağlayın.
# JSON keyring biçimi: sürüm numarası -> 32 baytlık base64 anahtar.
PII_ENCRYPTION_KEYRING=
PII_ACTIVE_ENCRYPTION_KEY_VERSION=1
PII_PHONE_HMAC_KEYRING=
PII_ACTIVE_PHONE_HMAC_KEY_VERSION=1

# Saha fotoğrafı PII keyring'inden ayrı bir AES-256-GCM keyring'i kullanır.
MEDIA_ENCRYPTION_KEYRING=
MEDIA_ACTIVE_ENCRYPTION_KEY_VERSION=1

# disabled: akış kapalı, synthetic: yalnız sentetik veri, live: release-v2 onaylı üretim.
FIELD_OBSERVATION_MODE=disabled
CRON_SECRET=

# Yalnızca `pnpm auth:local-user` ile yerel davetli kullanıcı oluşturmak içindir.
# Gerçek değerleri yalnızca git tarafından yok sayılan .env.local dosyasına yazın.
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_PASSWORD=
